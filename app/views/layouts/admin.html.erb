<!DOCTYPE html>
<html>
  <head>
    <title>Admin - Sistema de noticias</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
      * { box-sizing: border-box; }
      body {
        font-family: "Inter", -apple-system, sans-serif;
        margin: 0;
        background: #faf6f1;
        color: #3a2e2e;
      }
      nav {
        background: #fffdfb;
        padding: 1.1rem 2.5rem;
        display: flex;
        gap: 1.75rem;
        align-items: center;
        border-bottom: 2px solid #c9a15a;
      }
      nav a {
        color: #6b4a4a;
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
        letter-spacing: 0.02em;
        text-transform: uppercase;
      }
      nav a:hover { color: #b5476b; }
      nav form { margin-left: auto; }
      nav button {
        background: none;
        border: 1px solid #c9a15a;
        color: #8a6d1f;
        padding: 0.4rem 1rem;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        cursor: pointer;
      }
      main { max-width: 960px; margin: 2.5rem auto; padding: 0 1.5rem; }
      h1 {
        font-family: "Playfair Display", serif;
        font-size: 2rem;
        margin-bottom: 1.3rem;
        color: #7d2c47;
        border-bottom: 1px solid #c9a15a;
        padding-bottom: 0.6rem;
      }
      table {
        width: 100%; border-collapse: collapse; background: #fffdfb;
        border: 1px solid #ecdfc8;
      }
      th, td { padding: 0.85rem 1.1rem; text-align: left; border-bottom: 1px solid #f0e5d3; }
      th {
        background: #fbf3e6; font-size: 0.72rem; text-transform: uppercase;
        color: #8a6d1f; letter-spacing: 0.06em; border-bottom: 2px solid #c9a15a;
      }
      ul { list-style: none; padding: 0; }
      li {
        background: #fffdfb; padding: 0.9rem 1.2rem; margin-bottom: 0.5rem;
        border-left: 3px solid #c9a15a; border-bottom: 1px solid #f0e5d3;
      }
      a { color: #b5476b; }
      input[type="text"], input[type="email"], input[type="password"], textarea, select {
        width: 100%; padding: 0.6rem; margin: 0.3rem 0 1.2rem;
        border: 1px solid #ecdfc8; background: #fffdfb; font-size: 0.95rem;
      }
      input:focus, textarea:focus, select:focus {
        outline: none; border-color: #c9a15a;
      }
      button[type="submit"], input[type="submit"] {
        background: #7d2c47; color: #fdf6e8; border: 1px solid #c9a15a;
        padding: 0.65rem 1.6rem; cursor: pointer; font-size: 0.85rem;
        text-transform: uppercase; letter-spacing: 0.04em;
      }
      button[type="submit"]:hover, input[type="submit"]:hover { background: #5c2035; }
      form button, form input[type="submit"] { margin-right: 0.4rem; }
      .flash-notice {
        background: #fbf3e6; color: #7d2c47; padding: 0.7rem 1.2rem;
        margin: 1rem 1.5rem 0; border-left: 3px solid #c9a15a;
      }
      .flash-alert {
        background: #fbeaea; color: #8b2f2f; padding: 0.7rem 1.2rem;
        margin: 1rem 1.5rem 0; border-left: 3px solid #8b2f2f;
      }
      label { font-weight: 500; color: #6b4a4a; font-size: 0.9rem; }
    </style>
  </head>
  <body>
    <% if notice %><p class="flash-notice"><%= notice %></p><% end %>
    <% if alert %><p class="flash-alert"><%= alert %></p><% end %>
    <% if current_admin %>
      <nav>
        <%= link_to "Dashboard", admin_root_path %>
        <%= link_to "Noticias", admin_news_articles_path %>
        <%= link_to "Categorías", admin_categories_path %>
        <%= link_to "Usuarios", admin_users_path %>
        <%= link_to "Comentarios", admin_comments_path %>
        <%= button_to "Salir", admin_logout_path, method: :delete %>
      </nav>
    <% end %>
    <main>
      <%= yield %>
    </main>
  </body>
</html>