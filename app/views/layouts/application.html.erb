<!DOCTYPE html>

<html>
  <head>
    <title>Portal de noticias</title>

    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <style>
      * {
        box-sizing: border-box;
      }

      body {
        font-family: -apple-system, "Segoe UI", Roboto, sans-serif;
        margin: 0;
        min-height: 100vh;

        display: flex;
        align-items: center;
        justify-content: center;

        /* Fondo rosa */
        background: linear-gradient(
          135deg,
          #fce7f3,
          #f9a8d4,
          #ec4899
        );

        color: #831843;
      }

      main {
        background: white;
        padding: 3rem 3.5rem;
        border-radius: 16px;

        box-shadow: 0 10px 30px rgba(190, 24, 93, 0.20);

        text-align: center;
        max-width: 420px;
        width: 90%;
      }

      h1 {
        margin-top: 0;
        font-size: 1.6rem;
        color: #be185d;
      }

      p {
        color: #9d174d;
      }

      a.btn {
        display: inline-block;
        margin-top: 1rem;

        background: #ec4899;
        color: white;

        text-decoration: none;
        padding: 0.7rem 1.4rem;

        border-radius: 8px;
        font-weight: 500;

        transition: 0.2s;
      }

      a.btn:hover {
        background: #be185d;
        transform: translateY(-1px);
      }
    </style>
  </head>

  <body>
    <main>
      <%= yield %>
    </main>
  </body>
</html>