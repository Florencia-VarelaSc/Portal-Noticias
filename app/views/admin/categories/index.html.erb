<h1>Categorías</h1>
<%= link_to "Nueva categoría", new_admin_category_path %>
<ul>
  <% @categories.each do |cat| %>
    <li>
      <%= cat.name %>
      <%= link_to "Editar", edit_admin_category_path(cat) %>
      <%= button_to "Eliminar", admin_category_path(cat), method: :delete %>
    </li>
  <% end %>
</ul>
