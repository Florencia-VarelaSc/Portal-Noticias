<h1>Usuarios</h1>
<table border="1" cellpadding="6">
  <tr><th>Nombre</th><th>Email</th><th>Rol</th><th>Activo</th><th>Acciones</th></tr>
  <% @users.each do |u| %>
    <tr>
      <td><%= u.name %></td>
      <td><%= u.email %></td>
      <td><%= u.role %></td>
      <td><%= u.active? ? "Sí" : "No" %></td>
      <td><%= link_to "Editar", edit_admin_user_path(u) %></td>
    </tr>
  <% end %>
</table>
