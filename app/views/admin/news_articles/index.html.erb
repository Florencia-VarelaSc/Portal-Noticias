<h1>Noticias</h1>
<%= link_to "Nueva noticia", new_admin_news_article_path %>
<table border="1" cellpadding="6">
  <tr><th>Título</th><th>Categoría</th><th>Estado</th><th>Acciones</th></tr>
  <% @news_articles.each do |na| %>
    <tr>
      <td><%= link_to na.title, admin_news_article_path(na) %></td>
      <td><%= na.category.name %></td>
      <td><%= na.status %></td>
      <td>
        <%= link_to "Editar", edit_admin_news_article_path(na) %>
        <% if na.draft? || na.archived? %>
          <%= button_to "Publicar", publish_admin_news_article_path(na), method: :patch %>
        <% end %>
        <% if na.published? %>
          <%= button_to "Archivar", archive_admin_news_article_path(na), method: :patch %>
        <% end %>
        <%= button_to "Eliminar", admin_news_article_path(na), method: :delete %>
      </td>
    </tr>
  <% end %>
</table>
